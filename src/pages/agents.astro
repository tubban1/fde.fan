---
import SiteLayout from "../layouts/SiteLayout.astro";
import DocShell from "../components/DocShell.astro";
import { breadcrumbJsonLd } from "../lib/seo";

const agents = [
  {
    mark: "DX",
    href: "/diagnosis",
    title: "企业 AI 转型诊断 Agent",
    titleEn: "Enterprise AI Diagnosis Agent",
    status: "LIVE",
    body: "通过轻量访谈沉淀企业画像，生成机会地图、成熟度评分和 30/60/90 天路线图。",
    bodyEn: "Turns a lightweight interview into a company profile, opportunity map, maturity score, and 30/60/90-day roadmap.",
  },
  {
    mark: "WC",
    href: "/worldcup",
    title: "世界杯预测分析 Agent",
    titleEn: "World Cup Prediction Agent",
    status: "BETA",
    body: "融合 Elo、近期状态、人工补录特征和 LLM 解释，支持比赛预测与场景推演。",
    bodyEn: "Combines Elo, recent form, expert inputs, and LLM explanations for match prediction and scenario analysis.",
  },
  {
    mark: "API",
    href: "#third-party-agents",
    title: "第三方智能体独立接入",
    titleEn: "Independent Third-Party Agent Access",
    status: "OPEN",
    body: "支持外部团队把已上线的 Agent 接入 FDE FAN，保留独立入口、品牌说明、体验链接和案例拆解。",
    bodyEn: "External teams can plug live agents into FDE FAN with standalone entries, brand context, demo links, and case breakdowns.",
  },
];
---

<SiteLayout
  title="FDE FAN Agents | 智能体中心"
  description="FDE FAN 智能体中心：集中体验企业 AI 转型诊断、世界杯预测分析和后续行业智能体。"
  jsonLd={breadcrumbJsonLd([
    { name: "FDE FAN", path: "/" },
    { name: "Agents", path: "/agents" },
  ])}
>
  <DocShell
    eyebrow="AGENTS"
    title="智能体中心"
    titleEn="Agent Hub"
    description="这里集中放置可直接体验的 Agent，也支持第三方智能体以独立入口接入。它们不是课程资料，而是能和用户对话、推理、生成结果的产品化智能体。"
    descriptionEn="This hub collects productized agents users can run directly, and supports independent third-party agent entries. These are not course notes, but live agents that chat, reason, and generate outputs."
  >
    <section class="content-grid">
      {agents.map((agent) => (
        <a class="doc-card" href={agent.href}>
          <span class="tag">{agent.status}</span>
          <span class="card-mark">{agent.mark}</span>
          <h2>
            <span class="zh">{agent.title}</span>
            <span class="en">{agent.titleEn}</span>
          </h2>
          <p>
            <span class="zh">{agent.body}</span>
            <span class="en">{agent.bodyEn}</span>
          </p>
        </a>
      ))}
    </section>

    <section class="insight-lesson" id="third-party-agents">
      <p class="eyebrow">THIRD-PARTY ACCESS</p>
      <p>
        <span class="zh">FDE FAN 可以接入外部团队、企业或个人开发者的智能体：每个 Agent 保留独立访问入口、品牌归属、能力说明、适用场景、体验链接和课程案例拆解。这样智能体既能作为真实工具被使用，也能成为 FDE 学员学习“如何把 AI 工具交付成产品”的案例。</span>
        <span class="en">FDE FAN can host agents from external teams, companies, and independent builders. Each agent keeps its own entry point, ownership, capability brief, use cases, demo link, and course-style breakdown, so it works both as a real tool and as a learning case for FDE delivery.</span>
      </p>
      <p style="margin-top: 1rem;">
        <span class="zh">合作联系：</span><span class="en">Contact: </span><a href="mailto:info@fde.fan" style="color: #818cf8; font-weight: bold; text-decoration: none;">info@fde.fan</a>
      </p>
    </section>

    <section class="insight-lesson">
      <p class="eyebrow">LEARN TO BUILD</p>
      <p>
        <span class="zh">想学习这些智能体背后的流程、工具调用、评估与部署方法，可以进入 Agent 工作流课程。</span>
        <span class="en">To learn how these agents are designed, evaluated, and deployed, continue into the Agent Workflow course.</span>
      </p>
      <a class="cta-secondary" href="/learn/agent-workflows">
        <span class="zh">学习 Agent 工作流</span>
        <span class="en">Learn Agent Workflows</span>
      </a>
    </section>
  </DocShell>
</SiteLayout>
