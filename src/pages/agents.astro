---
import SiteLayout from "../layouts/SiteLayout.astro";
import DocShell from "../components/DocShell.astro";
import { breadcrumbJsonLd } from "../lib/seo";

const agents = [
  {
    mark: "DX",
    href: "/diagnosis",
    title: "企业 AI 转型诊断 Agent",
    titleEn: "Enterprise AI Diagnosis Agent",
    status: "LIVE",
    body: "通过轻量访谈沉淀企业画像，生成机会地图、成熟度评分和 30/60/90 天路线图。",
    bodyEn: "Turns a lightweight interview into a company profile, opportunity map, maturity score, and 30/60/90-day roadmap.",
  },
  {
    mark: "WC",
    href: "/worldcup",
    title: "世界杯预测分析 Agent",
    titleEn: "World Cup Prediction Agent",
    status: "BETA",
    body: "融合 Elo、近期状态、人工补录特征和 LLM 解释，支持比赛预测与场景推演。",
    bodyEn: "Combines Elo, recent form, expert inputs, and LLM explanations for match prediction and scenario analysis.",
  },
  {
    mark: "NEXT",
    href: "/learn/agent-workflows",
    title: "更多行业智能体",
    titleEn: "More Industry Agents",
    status: "PLANNED",
    body: "后续会继续接入跨境电商、文旅运营、数据审计、招生咨询等可体验智能体。",
    bodyEn: "More agents will cover commerce, tourism operations, data audit, admissions, and other practical workflows.",
  },
];
---

<SiteLayout
  title="FDE FAN Agents | 智能体中心"
  description="FDE FAN 智能体中心：集中体验企业 AI 转型诊断、世界杯预测分析和后续行业智能体。"
  jsonLd={breadcrumbJsonLd([
    { name: "FDE FAN", path: "/" },
    { name: "Agents", path: "/agents" },
  ])}
>
  <DocShell
    eyebrow="AGENTS"
    title="智能体中心"
    titleEn="Agent Hub"
    description="这里集中放置可直接体验的 Agent。它们不是课程资料，而是能和用户对话、推理、生成结果的产品化智能体。"
    descriptionEn="This hub collects productized agents that users can actually run, chat with, reason through, and use for outputs."
  >
    <section class="content-grid">
      {agents.map((agent) => (
        <a class="doc-card" href={agent.href}>
          <span class="tag">{agent.status}</span>
          <span class="card-mark">{agent.mark}</span>
          <h2>
            <span class="zh">{agent.title}</span>
            <span class="en">{agent.titleEn}</span>
          </h2>
          <p>
            <span class="zh">{agent.body}</span>
            <span class="en">{agent.bodyEn}</span>
          </p>
        </a>
      ))}
    </section>

    <section class="insight-lesson">
      <p class="eyebrow">LEARN TO BUILD</p>
      <p>
        <span class="zh">想学习这些智能体背后的流程、工具调用、评估与部署方法，可以进入 Agent 工作流课程。</span>
        <span class="en">To learn how these agents are designed, evaluated, and deployed, continue into the Agent Workflow course.</span>
      </p>
      <a class="cta-secondary" href="/learn/agent-workflows">
        <span class="zh">学习 Agent 工作流</span>
        <span class="en">Learn Agent Workflows</span>
      </a>
    </section>
  </DocShell>
</SiteLayout>
