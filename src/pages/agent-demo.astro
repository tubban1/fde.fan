---
import AgentDemoApp from "../components/diagnosis/AgentDemoApp.jsx";
import "../styles.css";

const title = "模拟智能体 Demo | FDE FAN";
const description = "基于企业 AI 诊断报告生成的模拟智能体原型，仅使用合成数据。";
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body>
    <AgentDemoApp client:load />
  </body>
</html>
