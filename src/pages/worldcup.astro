---
import SiteLayout from '../layouts/SiteLayout.astro';
import SocialShare from '../components/SocialShare';
import SchedulePrediction from '../components/worldcup/SchedulePrediction.tsx';

const title = "2026 World Cup Predictions | FDE FAN";
const description =
  "AI-powered 2026 World Cup predictions using Elo, recent form, expert scenarios, and match analysis.";
---

<SiteLayout title={title} description={description} image="/assets/wechat-share.jpg">
  <section class="relative min-h-screen bg-[#0B0F19] pt-24 pb-16 text-slate-300">
    <div class="absolute top-0 left-0 -z-10 h-96 w-full bg-gradient-to-b from-emerald-900/20 to-transparent pointer-events-none"></div>
    <div class="mx-auto mb-4 flex w-full max-w-5xl justify-between items-center px-4 md:px-8">
      <a href="https://github.com/tubban1/fde-worldcup-agent" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-800/80 border border-slate-700 text-sm font-medium hover:bg-slate-700/80 transition-colors">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        GitHub Open Source
      </a>
      <SocialShare client:load title={title} description={description} path="/worldcup" />
    </div>
    <SchedulePrediction client:load />
  </section>
</SiteLayout>
