---
import SiteLayout from "../../layouts/SiteLayout.astro";
---

<SiteLayout title="找回密码 | FDE FAN" description="通过邮箱找回 FDE FAN 登录密码。">
  <section class="auth-page">
    <form class="auth-card" id="forgotForm">
      <p class="eyebrow">PASSWORD RESET</p>
      <h1>找回密码</h1>
      <p>输入注册邮箱，我们会发送密码重置链接。</p>
      <label>
        邮箱
        <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
      </label>
      <button class="cta-primary" type="submit">发送重置邮件</button>
      <p class="auth-message" id="forgotMessage"></p>
    </form>
  </section>
  <script is:inline>
    const form = document.getElementById("forgotForm");
    const message = document.getElementById("forgotMessage");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = new FormData(form).get("email");
      message.textContent = "正在发送...";
      try {
        const res = await fetch("/api/diagnosis-auth/request-password-reset", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        message.textContent = data.message || data.error || "请求已提交。";
      } catch (error) {
        message.textContent = "发送失败，请稍后重试。";
      }
    });
  </script>
</SiteLayout>
