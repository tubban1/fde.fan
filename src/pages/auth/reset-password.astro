---
import SiteLayout from "../../layouts/SiteLayout.astro";
const token = Astro.url.searchParams.get("token") || "";
---

<SiteLayout title="重置密码 | FDE FAN" description="设置新的 FDE FAN 登录密码。">
  <section class="auth-page">
    <form class="auth-card" id="resetForm" data-token={token}>
      <p class="eyebrow">NEW PASSWORD</p>
      <h1>重置密码</h1>
      <p>请输入新密码。重置成功后，可以回到诊断 Agent 使用新密码登录。</p>
      <label>
        新密码
        <input name="password" type="password" required minlength="8" autocomplete="new-password" />
      </label>
      <label>
        确认新密码
        <input name="confirmPassword" type="password" required minlength="8" autocomplete="new-password" />
      </label>
      <button class="cta-primary" type="submit">确认重置</button>
      <p class="auth-message" id="resetMessage"></p>
    </form>
  </section>
  <script is:inline>
    const form = document.getElementById("resetForm");
    const message = document.getElementById("resetMessage");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const password = String(data.get("password") || "");
      const confirmPassword = String(data.get("confirmPassword") || "");
      const token = form.dataset.token || "";
      if (password !== confirmPassword) {
        message.textContent = "两次输入的密码不一致。";
        return;
      }
      message.textContent = "正在重置...";
      try {
        const res = await fetch("/api/diagnosis-auth/reset-password", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token, password }),
        });
        const result = await res.json();
        message.textContent = result.success ? "密码已重置，请返回登录。" : (result.error || "重置失败。");
      } catch (error) {
        message.textContent = "重置失败，请稍后重试。";
      }
    });
  </script>
</SiteLayout>
