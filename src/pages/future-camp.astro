---
import SiteLayout from "../layouts/SiteLayout.astro";
import { breadcrumbJsonLd } from "../lib/seo";

const modules = [
  ["3 Days", "AI Explorer Sprint", "用 3 天完成 AI 工具入门、Prompt 到作品、AI 图片/视频/网页 Mini Project 和一次英文 Demo。", "A three-day sprint covering AI tools, prompt-to-artifact work, image/video/web mini projects, and one English demo."],
  ["10 Days", "FDE Project Camp", "用 10 天完成真实项目：需求拆解、网页 Demo、Agent 工作流、英文 Presentation 和最终 Demo Day。", "A ten-day project camp for requirement breakdown, web demo, agent workflow, English presentation, and final Demo Day."],
];

const tracks = [
  ["3 天体验营", "3-Day Explorer Sprint", "适合第一次系统接触 AI 的学生。目标是快速建立 AI 创作信心，完成 2-3 个可展示作品，并理解 FDE 项目协作是什么。", "For students meeting AI systematically for the first time. The goal is to build confidence, produce 2-3 showable artifacts, and understand FDE-style collaboration."],
  ["10 天项目营", "10-Day FDE Project Camp", "适合想做出完整作品集的学生。目标是完成一个真实主题项目，包括页面、Agent 流程、素材、测试清单、英文演示和复盘。", "For students who want a stronger portfolio. The goal is to complete one real project with a page, agent flow, assets, checklist, English demo, and retrospective."],
];

const levels = [
  ["L1", "Explorer", "探索者", "第一次接触 AI，学会提问、尝试、观察结果。", "First contact with AI: ask, try, observe, and improve."],
  ["L2", "Builder", "构建者", "会使用 AI 工具完成页面、图片、视频或内容作品。", "Use AI tools to build pages, images, videos, or content artifacts."],
  ["L3", "Creator", "创造者", "能够围绕真实需求设计产品原型和 Agent Demo。", "Design product prototypes and agent demos around real needs."],
  ["L4", "Leader", "项目负责人", "能够拆任务、带团队、做英文展示和交付复盘。", "Break down tasks, lead a team, present in English, and run retrospectives."],
];

const schedule = [
  ["09:00-09:30", "Morning Briefing", "英语任务开场 / English mission briefing"],
  ["09:30-10:30", "AI Skill", "AI 技能训练 / AI skill practice"],
  ["10:45-12:00", "Workshop", "动手工作坊 / Guided workshop"],
  ["14:00-15:30", "Project Build", "项目开发 / Project sprint"],
  ["15:45-16:30", "Mentor Review", "导师反馈 / Mentor review"],
  ["16:30-17:00", "Daily Demo", "每日展示 / Daily demo"],
];

const outcomes = [
  ["AI 作品", "AI Artifact", "海报、视频、网页、小游戏或办公自动化作品。", "A poster, video, web page, mini game, or office automation artifact."],
  ["一个 Agent", "One Agent", "旅行 Agent、学习 Agent、餐厅 Agent 或其他行业智能体。", "A travel agent, learning agent, restaurant agent, or another industry agent."],
  ["HTML Demo", "HTML Demo", "可以放到 GitHub 或公开链接中的网页 Demo。", "A web demo that can be published on GitHub or shared as a live link."],
  ["英文 Presentation", "English Presentation", "每人 5 分钟，用英语介绍自己的项目。", "A five-minute English presentation explaining the project."],
  ["Demo Day", "Demo Day", "邀请家长、企业、学校观看最终成果展示。", "A final showcase for parents, companies, and schools."],
];
---

<SiteLayout
  title="FDE Future Camp | 全球AI未来工程师夏令营详细介绍"
  description="FDE Future Camp 全球AI未来工程师夏令营详细介绍：面向青少年和未来工程师的 AI 创造训练，覆盖 AI 工具协作、Prompt 到作品、Agent 入门、部署与展示。"
  jsonLd={breadcrumbJsonLd([
    { name: "FDE FAN", path: "/" },
    { name: "FDE Future Camp", path: "/future-camp" },
  ])}
>
  <section class="doc-hero">
    <p class="eyebrow">FDE FUTURE CAMP</p>
    <h1><span class="zh">全球 AI 未来工程师夏令营</span><span class="en">Global AI Future Engineer Camp</span></h1>
    <p>
      <span class="zh">全球首个 AI + Forward Deployed Engineer + 国际英语 + 项目实战暑期训练营。一个班，四个成长等级，13-22 岁学生在同一个真实项目中承担不同角色，像未来 AI 团队一样协作。</span>
      <span class="en">A summer camp combining AI, Forward Deployed Engineering, international English, and project delivery. One cohort, four growth levels, and students aged 13-22 collaborating in real projects like future AI teams.</span>
    </p>
    <div class="stat-row camp-stats">
      <div><strong>3 Days</strong><span><span class="zh">AI 体验营</span><span class="en">AI Explorer Sprint</span></span></div>
      <div><strong>10 Days</strong><span><span class="zh">FDE 项目营</span><span class="en">FDE Project Camp</span></span></div>
      <div><strong>13-22</strong><span><span class="zh">初一至大学生</span><span class="en">Grade 7 to University</span></span></div>
      <div><strong>UA5201314fyh</strong><span><span class="zh">报名咨询微信</span><span class="en">WeChat Contact</span></span></div>
    </div>
    <div class="hero-actions">
      <a class="cta-primary" href="/#camp-apply"><span class="zh">提交报名信息</span><span class="en">Apply Now</span></a>
      <a class="cta-secondary" href="/learn"><span class="zh">查看 FDE 学习站</span><span class="en">Explore FDE Academy</span></a>
    </div>
  </section>

  <section class="section-wrap band">
    <div class="section-heading">
      <p class="eyebrow">ONE COHORT</p>
      <h2><span class="zh">只做一个班：按能力成长，不按年龄分班。</span><span class="en">One cohort: grouped by capability, not age.</span></h2>
      <p><span class="zh">真实企业项目里，本来就是大学生带高中生，高中生带初中生。能力不同，但在同一个项目里协作：有人负责 Agent 架构，有人负责网页，有人负责海报，有人负责英文 Presentation。这比传统按年龄分班更接近 FDE 的工作方式。</span><span class="en">Real projects are mixed teams: university students may lead architecture, high school students may build web pages, younger students may create visuals, and strong English speakers may lead presentations. This is closer to how FDE work actually happens.</span></p>
    </div>
    <div class="content-grid camp-level-grid">
      {levels.map(([mark, enName, zhName, zhBody, enBody]) => (
        <div class="doc-card">
          <span class="tag">{mark}</span>
          <h2><span class="zh">{zhName}</span><span class="en">{enName}</span></h2>
          <p><span class="zh">{zhBody}</span><span class="en">{enBody}</span></p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-wrap">
    <div class="section-heading">
      <p class="eyebrow">PROGRAM FORMAT</p>
      <h2><span class="zh">两种课程长度：3 天入门，10 天完成项目。</span><span class="en">Two formats: 3 days to start, 10 days to ship.</span></h2>
      <p><span class="zh">课程从原来的长周期集中营调整为更容易安排的 3 天体验营和 10 天项目营。每天仍然围绕 AI 工具、项目 Workshop、导师 Review、Daily Demo 和 Project English 展开。</span><span class="en">The camp is now offered as a more flexible 3-day sprint and 10-day project camp. Each day still centers on AI tools, project workshops, mentor review, daily demos, and Project English.</span></p>
    </div>
    <div class="camp-info-grid">
      <div class="doc-card"><span class="tag">AGE</span><h2>13-22</h2><p><span class="zh">初一到大学生均可参加，入营后根据能力进入 L1-L4 成长等级。</span><span class="en">For grade 7 through university students, mapped into L1-L4 growth levels by capability.</span></p></div>
      <div class="doc-card"><span class="tag">DAILY</span><h2>09:00-17:00</h2><p><span class="zh">建议按全天制安排：上午 09:00-12:00，下午 14:00-17:00，也可根据营地/学校档期微调。</span><span class="en">Designed as a full-day format: 09:00-12:00 and 14:00-17:00, adjustable by venue or school schedule.</span></p></div>
      <div class="doc-card"><span class="tag">CONTACT</span><h2>UA5201314fyh</h2><p><span class="zh">添加微信咨询 3 天与 10 天课程费用、开营时间、名额和适合等级。</span><span class="en">Add WeChat to ask about fees, dates, seats, and the right level for each student.</span></p></div>
    </div>
  </section>

  <section class="section-wrap band">
    <div class="section-heading">
      <p class="eyebrow">COURSE OPTIONS</p>
      <h2><span class="zh">3 天是启动，10 天是交付。</span><span class="en">Three days starts the engine. Ten days ships the project.</span></h2>
    </div>
    <div class="content-grid">
      {tracks.map(([zhTitle, enTitle, zhBody, enBody]) => (
        <div class="doc-card">
          <span class="tag">TRACK</span>
          <h2><span class="zh">{zhTitle}</span><span class="en">{enTitle}</span></h2>
          <p><span class="zh">{zhBody}</span><span class="en">{enBody}</span></p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-wrap band">
    <div class="section-heading">
      <p class="eyebrow">LEARNING PATH</p>
      <h2><span class="zh">课程路径：先做作品，再做项目。</span><span class="en">Learning path: artifacts first, projects next.</span></h2>
    </div>
    <div class="timeline compact">
      {modules.map(([mark, title, zhBody, enBody]) => (
        <a href="/#camp-apply">
          <strong>{mark}</strong>
          <span>{title}</span>
          <small><span class="zh">{zhBody}</span><span class="en">{enBody}</span></small>
        </a>
      ))}
    </div>
  </section>

  <section class="section-wrap">
    <div class="section-heading">
      <p class="eyebrow">PROJECT ENGLISH</p>
      <h2><span class="zh">每天都有英语，但不是传统英语课。</span><span class="en">Daily English, but not a traditional English class.</span></h2>
      <p><span class="zh">英语环节围绕项目展开：Morning Briefing 讨论 Today's Mission，下午 Project Review 用英语介绍自己的 Demo。3 天营完成一次短 Demo，10 天营完成 5 分钟英文 Presentation。</span><span class="en">English is embedded in project work: Morning Briefing discusses Today's Mission, and afternoon Project Review explains demos in English. The 3-day sprint ends with a short demo; the 10-day camp ends with a five-minute presentation.</span></p>
    </div>
    <div class="schedule-table">
      {schedule.map(([time, title, body]) => (
        <div>
          <strong>{time}</strong>
          <span>{title}</span>
          <small>{body}</small>
        </div>
      ))}
    </div>
  </section>

  <section class="section-wrap band">
    <div class="section-heading">
      <p class="eyebrow">OUTCOMES</p>
      <h2><span class="zh">课程结束后，孩子能拿得出什么？</span><span class="en">What students can show after the camp.</span></h2>
      <p><span class="zh">家长不需要只看到“学过哪些工具”，而要看到孩子能独立完成 AI 作品、参与真实 AI 项目、理解未来岗位的工作方式，并用英语讲清楚自己的作品。</span><span class="en">Parents should not only see a tool list. They should see students complete AI artifacts, join a real AI project, understand future work patterns, and explain their work in English.</span></p>
    </div>
    <div class="content-grid">
      {outcomes.map(([zhTitle, enTitle, zhBody, enBody]) => (
        <div class="doc-card">
          <span class="tag">DELIVERABLE</span>
          <h2><span class="zh">{zhTitle}</span><span class="en">{enTitle}</span></h2>
          <p><span class="zh">{zhBody}</span><span class="en">{enBody}</span></p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-wrap">
    <div class="section-heading">
      <p class="eyebrow">WHY FDE</p>
      <h2><span class="zh">这就是 FDE：在真实项目里承担角色。</span><span class="en">This is FDE: taking roles inside real projects.</span></h2>
      <p><span class="zh">例如一个旅行社 Agent 项目：大学生负责 Agent 架构，高中生负责网页和交互，初中生负责海报和素材，英语好的学生负责 Presentation。老师不讲四套课，而是用一个项目，让不同能力的人完成不同难度的任务。</span><span class="en">For example, in a Travel Agent project, university students may design the agent architecture, high school students build the web experience, younger students create visuals, and strong English speakers lead the presentation. One project, different responsibilities, shared delivery.</span></p>
    </div>
    <a class="diagnosis-banner" href="/#camp-apply">
      <span>WeChat: UA5201314fyh</span>
      <strong><span class="zh">报名 FDE Future Camp</span><span class="en">Apply for FDE Future Camp</span></strong>
    </a>
  </section>

  <div class="camp-runner" aria-hidden="true">
    <div class="camp-runner-optical"></div>
  </div>

  <script>
    const runner = document.querySelector<HTMLElement>(".camp-runner");
    const runnerOptical = document.querySelector<HTMLElement>(".camp-runner-optical");

    if (runner && runnerOptical) {
      let ticking = false;

      const updateRunner = () => {
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const progress = Math.min(1, Math.max(0, window.scrollY / maxScroll));
        const leftOffset = Number.parseFloat(getComputedStyle(runner).left) || 0;
        const maxTravel = Math.max(0, window.innerWidth - runner.getBoundingClientRect().width - leftOffset * 2);

        runner.style.setProperty("--runner-travel", `${maxTravel * progress}px`);
        runnerOptical.style.setProperty("--runner-x", `${window.scrollY * 0.72}px`);
        ticking = false;
      };

      const requestRunnerUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateRunner);
      };

      updateRunner();
      window.addEventListener("scroll", requestRunnerUpdate, { passive: true });
      window.addEventListener("resize", requestRunnerUpdate);
      window.addEventListener("pageshow", requestRunnerUpdate);
    }
  </script>
</SiteLayout>
