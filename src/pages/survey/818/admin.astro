---
import Survey818Dashboard from "../../../components/survey/Survey818Dashboard.jsx";
import "../../../styles.css";

const title = "818 美妆 AI 成熟度诊断 · 实时监控与 Leads 看板 | FDE FAN";
const description = "实时追踪 818 大会填报企业、AI 成熟度得分、五维能力样本与 Leads 线索库";
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#05070d" />
    <title>{title}</title>
  </head>
  <body class="bg-[#05070d] text-white">
    <Survey818Dashboard client:load />
  </body>
</html>
