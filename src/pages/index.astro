---
import SiteLayout from "../layouts/SiteLayout.astro";
import { aiFdeLoop, learningTracks } from "../data/site";

const allianceMembers = [
  { name: "TG Technologie", image: "/assets/alliance/tg-technologie.png", type: "logo" },
  { name: "WeOPC", image: "/assets/alliance/weopc.png", type: "logo" },
  { name: "Bin Altman", org: "TG Technologies", image: "/assets/alliance/bin-altman.png", type: "avatar" },
  { name: "Ziyange", org: "TG Technologies", image: "/assets/alliance/ziyange.png", type: "avatar" },
  { name: "Shawn Von", org: "TG Technologies", image: "/assets/alliance/shawn-von.png", type: "avatar" },
  { name: "Liang Rao", org: "FDE FAN Alliance", image: "/assets/alliance/liang-rao.png", type: "avatar" },
  { name: "Beckwen", org: "Kuaishou", image: "/assets/alliance/beckwen.png", type: "avatar" },
  { name: "Shen Pei", org: "Wanwuhuanxin", image: "/assets/alliance/shen-pei.png", type: "avatar" },
  { name: "Jane Yao", org: "Baqian Law", image: "/assets/alliance/jane-yao.png", type: "avatar" },
  { name: "AliceLuo", org: "WeOPC", image: "/assets/alliance/alice-luo.png", type: "avatar" },
  { name: "Lotte Huang", org: "Macau University of Science and Technology", image: "/assets/alliance/lotte-huang.png", type: "avatar" },
  { name: "Wenjun Yuan", org: "AI Matrix Seo Agent", image: "/assets/alliance/wenjun-yuan.png", type: "logo" },
  { name: "LimitlessChallenge", org: "Freelancer", image: "/assets/alliance/limitlesschallenge.png", type: "avatar" },
  { name: "Design LIN", org: "Freelancer", image: "/assets/alliance/design-lin.png", type: "avatar" },
  { name: "Hank", org: "Freelancer", image: "/assets/alliance/hank.png", type: "avatar" },
  { name: "Elena", org: "Freelancer", image: "/assets/alliance/elena.png", type: "avatar" },
  { name: "AuraBaba 灵光爸爸", image: "/assets/alliance/aurababa.png", type: "logo" },
  { name: "OpenAI", image: "/assets/alliance/openai.png", type: "logo" },
  { name: "Anthropic", image: "/assets/alliance/anthropic.png", type: "logo" },
  { name: "NVIDIA", image: "/assets/alliance/nvidia.png", type: "logo" },
  { name: "Palantir", image: "/assets/alliance/palantir.svg", type: "logo" },
  { name: "Elon Musk", org: "xAI / Tesla", image: "/assets/alliance/elon-musk.png", type: "avatar" },
  { name: "EPFL", image: "/assets/alliance/epfl.png", type: "logo" },
  { name: "PHBern", image: "/assets/alliance/phbern.png", type: "logo" },
];

const allianceMarquee = [...allianceMembers, ...allianceMembers];
const allianceMemberCount = allianceMembers.length;
---

<SiteLayout title="FDE Future Camp | 全球AI未来工程师夏令营" description="FDE Future Camp 是面向全球青少年和未来工程师的 AI 夏令营，训练学员用 AI 工具完成创意、应用、智能体、部署和作品展示。">
  <section class="future-camp-hero">
    <img class="future-camp-hero-bg" src="/assets/hero2.png" alt="" />
    <div class="future-camp-hero-glass" aria-hidden="true"></div>
    <div class="future-camp-hero-copy">
      <p class="eyebrow">FDE AI FUTURE CAMP</p>
      <h1>
        <span class="zh">沿着 AI 路径，走向未来工程师。</span>
        <span class="en">Follow the AI path into future engineering.</span>
      </h1>
      <p class="future-camp-hero-lead">
        <span class="zh">13-22 岁学生在同一个真实项目里完成学习、实践、认证、项目、展示与未来职业启蒙。</span>
        <span class="en">Students aged 13-22 move through learning, practice, certification, projects, showcase, and future career discovery in one real project camp.</span>
      </p>
      <div class="future-camp-hero-stats" aria-label="FDE Future Camp highlights">
        <span>7/13-7/31</span>
        <span>¥7,980</span>
        <span>90h</span>
        <span>20-30</span>
      </div>
      <div class="hero-actions">
        <a class="cta-primary" href="#camp-apply"><span class="zh">提交报名信息</span><span class="en">Apply Now</span></a>
        <a class="cta-secondary" href="/future-camp"><span class="zh">查看详细介绍</span><span class="en">View Details</span></a>
      </div>
    </div>
  </section>

  <section class="section-wrap band" id="future-camp-intro">
    <div class="section-heading">
      <p class="eyebrow">CAMP SYSTEM</p>
      <h2><span class="zh">夏令营训练的是 AI 时代的工程思维。</span><span class="en">The camp trains engineering thinking for the AI era.</span></h2>
      <p><span class="zh">我们把 FDE 的真实交付方法改造成适合学生的创造训练：先定义问题，再调用 AI 工具，最后用作品、演示和复盘证明学习成果。</span><span class="en">We adapt FDE delivery practice into a student-friendly creation path: frame the problem, direct AI tools, then prove learning through projects, demos, and retrospectives.</span></p>
    </div>
    <div class="loop-grid">
      {aiFdeLoop.map((item) => (
        <div class="loop-card">
          <span>{item.mark}</span>
          <h3><span class="zh">{item.zh}</span><span class="en">{item.en}</span></h3>
          <p><span class="zh">{item.text}</span><span class="en">{item.textEn}</span></p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-wrap">
    <div class="section-heading">
      <p class="eyebrow">ACADEMY SYSTEM</p>
      <h2><span class="zh">像 W3Schools 一样清晰，但面向真实交付。</span><span class="en">Structured like a learning site. Built for real delivery.</span></h2>
      <p><span class="zh">FDE FAN 不只展示课程大纲，而是把教程、案例、练习、项目任务书和交付模板放进同一个学习系统。</span><span class="en">FDE FAN combines tutorials, cases, exercises, project briefs, and delivery templates into one practical learning system.</span></p>
    </div>
    <div class="track-grid">
      {learningTracks.map((track) => (
        <a class="track-card" href={track.href}>
          <span class="card-mark">{track.mark}</span>
          <h3><span class="zh">{track.zh}</span><span class="en">{track.en}</span></h3>
          <p><span class="zh">{track.summary}</span><span class="en">{track.summaryEn}</span></p>
        </a>
      ))}
    </div>
  </section>

  <section class="section-wrap">
    <div class="section-heading">
      <p class="eyebrow">MARKET DEMAND</p>
      <h2><span class="zh">巨大的 FDE 人才缺口与薪资红利</span><span class="en">Massive FDE Talent Shortage & Salary Premium</span></h2>
      <p><span class="zh">全球市场需求旺盛，具备“业务理解 + AI应用开发/工程实现 + 交付落地”能力的复合型人才最受欢迎。</span><span class="en">Strong global market demand. Talents combining business insight, AI engineering, and delivery are highly sought after.</span></p>
    </div>
    <div class="image-showcase">
      <!-- 请确保将图片重命名为 fde-salary-analysis.jpg 或 png 并放入 public/assets/ 文件夹中 -->
      <img src="/assets/fde-salary-analysis.png" alt="FDE 招聘需求与薪资分析" loading="lazy" />
    </div>
  </section>

  <section class="section-wrap band" id="camp-apply">
    <div class="camp-apply-grid">
      <div class="section-heading">
        <p class="eyebrow">APPLY</p>
        <h2><span class="zh">提交 FDE Future Camp 报名信息</span><span class="en">Apply for FDE Future Camp</span></h2>
        <p><span class="zh">填写后会直接保存到报名数据库。邮箱不是必填项，我们会优先通过你留下的微信、WhatsApp 或电话联系。</span><span class="en">Your application is saved directly to our database. Email is optional; we will use your preferred contact method first.</span></p>
        <a class="cta-secondary" href="/future-camp"><span class="zh">查看夏令营详细介绍</span><span class="en">View Camp Details</span></a>
      </div>
      <form class="camp-apply-form" data-camp-form>
        <label>
          <span class="zh">学生姓名</span><span class="en">Student Name</span>
          <input name="studentName" required autocomplete="name" />
        </label>
        <label>
          <span class="zh">年龄 / 年级</span><span class="en">Age / Grade</span>
          <input name="ageGrade" required />
        </label>
        <label>
          <span class="zh">家长或联系人邮箱（选填）</span><span class="en">Parent or Contact Email (Optional)</span>
          <input name="email" type="email" autocomplete="email" />
        </label>
        <label>
          <span class="zh">微信 / WhatsApp / 电话</span><span class="en">WeChat / WhatsApp / Phone</span>
          <input name="contact" required />
        </label>
        <label>
          <span class="zh">感兴趣方向</span><span class="en">Interested Track</span>
          <select name="track">
            <option value="AI 应用开发">AI 应用开发 / AI App Building</option>
            <option value="AI 智能体">AI 智能体 / AI Agents</option>
            <option value="AI 设计与内容">AI 设计与内容 / AI Design & Content</option>
            <option value="AI 科学探索">AI 科学探索 / AI Science Exploration</option>
          </select>
        </label>
        <label class="full">
          <span class="zh">补充说明</span><span class="en">Notes</span>
          <textarea name="notes" rows="4" placeholder="学习背景、时间安排、希望完成的作品..."></textarea>
        </label>
        <button class="cta-primary" type="submit"><span class="zh">提交报名信息</span><span class="en">Submit Application</span></button>
        <p class="camp-form-note" data-camp-form-note>
          <span class="zh">提交后会保存到 FDE FAN 报名数据库。</span>
          <span class="en">Submission will be saved to the FDE FAN application database.</span>
        </p>
      </form>
    </div>
  </section>

  <section class="alliance-section" aria-label="FDE alliance members">
    <div class="alliance-heading">
      <p class="eyebrow">FDE ALLIANCE</p>
      <h2><span class="zh">FDE 联盟成员</span><span class="en">FDE Alliance Members</span></h2>
    </div>
    <div class="alliance-marquee">
      <div class="alliance-track" data-alliance-track data-member-count={allianceMemberCount}>
        {allianceMarquee.map((member) => (
          <div class="alliance-item">
            <span class={`alliance-logo ${member.type}`}>
              <img src={member.image} alt={`${member.name} logo`} loading="lazy" />
            </span>
            <span class="alliance-copy">
              <strong>{member.name}</strong>
              {member.org && <small>{member.org}</small>}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const track = document.querySelector("[data-alliance-track]");
    if (track instanceof HTMLElement) {
      const count = Number(track.dataset.memberCount || 0);
      const sourceItems = Array.from(track.children).slice(0, count);
      for (let index = sourceItems.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [sourceItems[index], sourceItems[swapIndex]] = [sourceItems[swapIndex], sourceItems[index]];
      }
      const firstLoop = sourceItems.map((item) => item.cloneNode(true));
      const secondLoop = sourceItems.map((item) => item.cloneNode(true));
      track.replaceChildren(...firstLoop, ...secondLoop);
    }

    const campForm = document.querySelector("[data-camp-form]");
    const campFormNote = document.querySelector("[data-camp-form-note]");
    campForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(campForm instanceof HTMLFormElement)) return;

      const formData = new FormData(campForm);
      const payload = Object.fromEntries(formData.entries());
      const submitButton = campForm.querySelector("button[type='submit']");

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      try {
        const response = await fetch("/api/future-camp/apply", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result?.ok !== true) {
          throw new Error(result?.message || "提交失败，请稍后重试。");
        }
        campForm.reset();
        if (campFormNote instanceof HTMLElement) {
          campFormNote.textContent = "报名信息已保存，我们会尽快联系你。";
          campFormNote.classList.add("active");
        }
      } catch (error) {
        if (campFormNote instanceof HTMLElement) {
          campFormNote.textContent = error instanceof Error ? error.message : "提交失败，请稍后重试。";
          campFormNote.classList.remove("active");
        }
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  </script>
</SiteLayout>
