---
import SiteLayout from "../layouts/SiteLayout.astro";
import { aiFdeLoop, assessmentLevels, boundaryItems, industryLabs, learningTracks, outcomes, stats } from "../data/site";

const allianceMembers = [
  { name: "TG Technologie", image: "/assets/alliance/tg-technologie.png", type: "logo" },
  { name: "WeOPC", image: "/assets/alliance/weopc.png", type: "logo" },
  { name: "Bin Altman", org: "TG Technologies", image: "/assets/alliance/bin-altman.png", type: "avatar" },
  { name: "Ziyange", org: "TG Technologies", image: "/assets/alliance/ziyange.png", type: "avatar" },
  { name: "Shawn Von", org: "TG Technologies", image: "/assets/alliance/shawn-von.png", type: "avatar" },
  { name: "Liang Rao", org: "FDE FAN Alliance", image: "/assets/alliance/liang-rao.png", type: "avatar" },
  { name: "Beckwen", org: "Kuaishou", image: "/assets/alliance/beckwen.png", type: "avatar" },
  { name: "Shen Pei", org: "Wanwuhuanxin", image: "/assets/alliance/shen-pei.png", type: "avatar" },
  { name: "Jane Yao", org: "Baqian Law", image: "/assets/alliance/jane-yao.png", type: "avatar" },
  { name: "AliceLuo", org: "WeOPC", image: "/assets/alliance/alice-luo.png", type: "avatar" },
  { name: "Lotte Huang", org: "Macau University of Science and Technology", image: "/assets/alliance/lotte-huang.png", type: "avatar" },
  { name: "Wenjun Yuan", org: "AI Matrix Seo Agent", image: "/assets/alliance/wenjun-yuan.png", type: "logo" },
  { name: "LimitlessChallenge", org: "Freelancer", image: "/assets/alliance/limitlesschallenge.png", type: "avatar" },
  { name: "Design LIN", org: "Freelancer", image: "/assets/alliance/design-lin.png", type: "avatar" },
  { name: "Hank", org: "Freelancer", image: "/assets/alliance/hank.png", type: "avatar" },
  { name: "Elena", org: "Freelancer", image: "/assets/alliance/elena.png", type: "avatar" },
  { name: "AuraBaba 灵光爸爸", image: "/assets/alliance/aurababa.png", type: "logo" },
  { name: "OpenAI", image: "/assets/alliance/openai.png", type: "logo" },
  { name: "Anthropic", image: "/assets/alliance/anthropic.png", type: "logo" },
  { name: "NVIDIA", image: "/assets/alliance/nvidia.png", type: "logo" },
  { name: "Palantir", image: "/assets/alliance/palantir.svg", type: "logo" },
  { name: "Elon Musk", org: "xAI / Tesla", image: "/assets/alliance/elon-musk.png", type: "avatar" },
  { name: "EPFL", image: "/assets/alliance/epfl.png", type: "logo" },
  { name: "PHBern", image: "/assets/alliance/phbern.png", type: "logo" },
];

const allianceMarquee = [...allianceMembers, ...allianceMembers];
const allianceMemberCount = allianceMembers.length;
---

<SiteLayout title="FDE FAN Academy | AI Agent FDE 前线部署工程师学习站" description="FDE FAN Academy 将课程、案例、项目和企业 AI 转型诊断 Agent 融合，训练学员完成 Prompt、前端 Demo、Agent 工作流、部署链接和交付文档。">
  <section class="scroll-video-hero" data-scroll-video-hero>
    <div class="scroll-video-sticky">
      <video
        class="scroll-video-bg"
        src="/assets/fde-fan-hero-scroll.mp4"
        poster="/assets/fde-fan-hero-poster.jpg"
        muted
        playsinline
        preload="auto"
        data-scroll-video
      ></video>
      <div class="scroll-video-shade"></div>
      <div class="grid-mask"></div>
      <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
      <div class="scroll-hero-copy">
        <article class="scroll-hero-panel active" data-scroll-panel>
          <p class="eyebrow">AI-FDE x Industry Agents x Deployment</p>
          <h1 class="hero-title">FDE FAN</h1>
          <p class="hero-subtitle">
            <span class="zh">AI-FDE 前线部署工程师学习站</span>
            <span class="en">AI Forward Deployed Engineer Academy</span>
          </p>
          <p class="scroll-hint">
            <span class="zh">向下滑动，进入 FDE 交付现场。</span>
            <span class="en">Scroll down to enter the FDE delivery flow.</span>
          </p>
        </article>

        <article class="scroll-hero-panel" data-scroll-panel>
          <p class="eyebrow">01 / INTENT</p>
          <h2><span class="zh">先读懂业务，不急着写代码。</span><span class="en">Understand the business before writing code.</span></h2>
          <p><span class="zh">FDE 从企业目标、用户场景、数据边界和验收标准开始，把模糊需求拆成 AI 工具能执行的任务。</span><span class="en">FDE starts from goals, users, data boundaries, and acceptance checks, turning vague needs into AI-tool tasks.</span></p>
        </article>

        <article class="scroll-hero-panel" data-scroll-panel>
          <p class="eyebrow">02 / AGENT</p>
          <h2><span class="zh">把 Prompt、工具和流程编排成 Agent。</span><span class="en">Orchestrate prompts, tools, and workflows into agents.</span></h2>
          <p><span class="zh">企业诊断、世界杯预测和第三方智能体接入，都会作为真实产品案例被拆解、复刻和升级。</span><span class="en">Diagnosis, World Cup prediction, and third-party agent access become real product cases to study, rebuild, and improve.</span></p>
        </article>

        <article class="scroll-hero-panel" data-scroll-panel>
          <p class="eyebrow">03 / DEPLOY</p>
          <h2><span class="zh">部署不是“发链接”，而是让系统稳定运行。</span><span class="en">Deployment is not just a link. It is reliable operation.</span></h2>
          <p><span class="zh">训练构建、环境变量、接口、日志、回滚、评估和上线验收，让 AI 应用能被真实用户使用。</span><span class="en">Learn builds, env vars, APIs, logs, rollback, evaluation, and launch checks so AI apps can serve real users.</span></p>
        </article>

        <article class="scroll-hero-panel" data-scroll-panel>
          <p class="eyebrow">04 / START</p>
          <h2><span class="zh">从课程进入，从交付毕业。</span><span class="en">Enter through lessons. Graduate through delivery.</span></h2>
          <p><span class="zh">从业务意图、上下文工程、工具权限、Agent 工作流、评估审计到部署交付，训练学员把企业需求转成可验证的 AI 应用。</span><span class="en">Train intent framing, context engineering, tool access, agent workflow, evaluation, audit, and deployment for verifiable AI applications.</span></p>
          <div class="hero-actions">
            <a class="cta-primary" href="/learn"><span class="zh">开始学习 FDE 路径</span><span class="en">Start the FDE Path</span></a>
            <a class="cta-secondary" href="/agents"><span class="zh">进入智能体中心</span><span class="en">Open Agent Hub</span></a>
            <button class="cta-secondary join-btn"><span class="zh">加入我们</span><span class="en">Join Us</span></button>
          </div>
          <div class="stat-row">
            {stats.map(([value, zh, en]) => (
              <div>
                <strong>{value}</strong>
                <span class="zh">{zh}</span>
                <span class="en">{en}</span>
              </div>
            ))}
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section-wrap band">
    <div class="section-heading">
      <p class="eyebrow">AI-FDE LOOP</p>
      <h2><span class="zh">向真实 AI-FDE 靠拢：不是聊天，是受控交付闭环。</span><span class="en">Closer to real AI-FDE work: not chatting, but controlled delivery loops.</span></h2>
      <p><span class="zh">借鉴企业级 AI-FDE 的工作方式，课程强化意图、上下文、权限、工具、验证、评审和审计，让学员知道什么时候该让 AI 做，什么时候必须人审和回退。</span><span class="en">Inspired by enterprise AI-FDE practice, the curriculum emphasizes intent, context, access, tools, validation, review, and audit.</span></p>
    </div>
    <div class="loop-grid">
      {aiFdeLoop.map((item) => (
        <div class="loop-card">
          <span>{item.mark}</span>
          <h3><span class="zh">{item.zh}</span><span class="en">{item.en}</span></h3>
          <p><span class="zh">{item.text}</span><span class="en">{item.textEn}</span></p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-wrap">
    <div class="section-heading">
      <p class="eyebrow">ACADEMY SYSTEM</p>
      <h2><span class="zh">像 W3Schools 一样清晰，但面向真实交付。</span><span class="en">Structured like a learning site. Built for real delivery.</span></h2>
      <p><span class="zh">FDE FAN 不只展示课程大纲，而是把教程、案例、练习、项目任务书和交付模板放进同一个学习系统。</span><span class="en">FDE FAN combines tutorials, cases, exercises, project briefs, and delivery templates into one practical learning system.</span></p>
    </div>
    <div class="track-grid">
      {learningTracks.map((track) => (
        <a class="track-card" href={track.href}>
          <span class="card-mark">{track.mark}</span>
          <h3><span class="zh">{track.zh}</span><span class="en">{track.en}</span></h3>
          <p><span class="zh">{track.summary}</span><span class="en">{track.summaryEn}</span></p>
        </a>
      ))}
    </div>
  </section>

  <section class="section-wrap band">
    <div class="section-heading">
      <p class="eyebrow">VERTICAL LABS</p>
      <h2><span class="zh">把垂直行业独立出来，做成可复用解决方案。</span><span class="en">Separate vertical industries into reusable solution labs.</span></h2>
      <p><span class="zh">跨境电商来自 OPC 工具矩阵和链主资源；文旅面向景区、酒店、旅行社、文博场馆和目的地运营。</span><span class="en">Commerce is grounded in the OPC tool matrix; culture-tourism covers attractions, hotels, agencies, museums, and destination operations.</span></p>
    </div>
    <div class="industry-hero-grid">
      {industryLabs.map((lab) => (
        <a class="industry-card" href={lab.href}>
          <span class="card-mark">{lab.mark}</span>
          <h3><span class="zh">{lab.zh}</span><span class="en">{lab.en}</span></h3>
          <p><span class="zh">{lab.summary}</span><span class="en">{lab.summaryEn}</span></p>
          <div class="chip-row">
            {lab.signals.slice(0, 8).map((signal) => <span>{signal}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section-wrap band">
    <div class="section-heading">
      <p class="eyebrow">WHAT FDE SHIPS</p>
      <h2><span class="zh">最后不是证书，是可展示的交付链路。</span><span class="en">The output is not a slogan. It is a delivery chain.</span></h2>
    </div>
    <div class="outcome-grid">
      {outcomes.map((item) => (
        <div class="metric-card">
          <b>{item.mark}</b>
          <span class="zh">{item.text}</span>
          <span class="en">{item.en}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section-wrap">
    <div class="section-heading">
      <p class="eyebrow">AGENTS & THIRD-PARTY ACCESS</p>
      <h2><span class="zh">可体验智能体已纳入课程主线。</span><span class="en">Productized agents become core course cases.</span></h2>
      <p><span class="zh">企业诊断、世界杯预测和后续行业智能体都集中在 Agents 中。它们不是摆设，而是学员会拆解、复刻和升级的真实 AI 产品。</span><span class="en">Diagnosis, World Cup prediction, and future industry agents live in Agents. Learners study, rebuild, and improve them as real AI products.</span></p>
      
      <div class="third-party-access" style="margin-top: 1.5rem; padding: 1.5rem; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 0.75rem; text-align: left;">
        <h3 style="color: #818cf8; font-size: 1.1rem; margin-top: 0; margin-bottom: 0.75rem;">THIRD-PARTY ACCESS 外部智能体接入</h3>
        <p style="font-size: 0.95rem; color: #cbd5e1; line-height: 1.6; margin-bottom: 1rem;"><span class="zh">FDE FAN 可以接入外部团队、企业或个人开发者的智能体：每个 Agent 保留独立访问入口、品牌归属、能力说明、适用场景、体验链接和课程案例拆解。这样智能体既能作为真实工具被使用，也能成为 FDE 学员学习“如何把 AI 工具交付成产品”的案例。</span><span class="en">FDE FAN supports third-party agents from external teams or individuals. Each Agent retains its standalone access, brand attribution, use cases, and becomes a real-world case study for FDE learners.</span></p>
        <p style="font-size: 0.95rem; color: #cbd5e1; margin: 0;"><span class="zh">合作联系：</span><span class="en">Contact: </span><a href="mailto:info@fde.fan" style="color: #818cf8; font-weight: bold; text-decoration: none;">info@fde.fan</a></p>
      </div>
    </div>
    <a class="diagnosis-banner" href="/agents">
      <span>fde.fan/agents</span>
      <strong><span class="zh">打开智能体中心</span><span class="en">Open Agent Hub</span></strong>
    </a>
  </section>

  <section class="section-wrap band">
    <div class="section-heading">
      <p class="eyebrow">ASSESSMENT</p>
      <h2><span class="zh">评分、分层与后续路径</span><span class="en">Assessment, levels, and next paths</span></h2>
    </div>
    <div class="level-grid">
      {assessmentLevels.map(([level, score, zh, en]) => (
        <div class="level-card">
          <strong>{level}</strong>
          <span>{score}</span>
          <p class="zh">{zh}</p>
          <p class="en">{en}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section-wrap">
    <div class="boundary-panel">
      <h2><span class="zh">清晰边界，可信招生。</span><span class="en">Clear boundaries, credible enrollment.</span></h2>
      <div>
        {boundaryItems.map((item) => (
          <p><span>OK</span>{item}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="alliance-section" aria-label="FDE alliance members">
    <div class="alliance-heading">
      <p class="eyebrow">FDE ALLIANCE</p>
      <h2><span class="zh">FDE 联盟成员</span><span class="en">FDE Alliance Members</span></h2>
    </div>
    <div class="alliance-marquee">
      <div class="alliance-track" data-alliance-track data-member-count={allianceMemberCount}>
        {allianceMarquee.map((member) => (
          <div class="alliance-item">
            <span class={`alliance-logo ${member.type}`}>
              <img src={member.image} alt={`${member.name} logo`} loading="lazy" />
            </span>
            <span class="alliance-copy">
              <strong>{member.name}</strong>
              {member.org && <small>{member.org}</small>}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="join-bottom-actions" style="text-align: center; margin-bottom: 120px;">
    <button class="cta-secondary join-btn"><span class="zh">加入我们</span><span class="en">Join Us</span></button>
  </div>

  <div id="join-modal" class="join-modal-overlay">
    <div class="join-modal-content">
      <button class="join-modal-close">&times;</button>
      <h3><span class="zh">扫码加入联盟交流群</span><span class="en">Scan to join FDE Alliance</span></h3>
      <img src="/assets/join-qr.png" alt="Join Us QR Code" class="join-qr-img" />
    </div>
  </div>

  <style>
    .join-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      backdrop-filter: blur(4px);
    }
    .join-modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
    .join-modal-content {
      background: #1e293b;
      padding: 2rem;
      border-radius: 1rem;
      border: 1px solid #334155;
      text-align: center;
      position: relative;
      transform: scale(0.95);
      transition: transform 0.3s ease;
      max-width: 90vw;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    .join-modal-overlay.active .join-modal-content {
      transform: scale(1);
    }
    .join-modal-content h3 {
      margin-top: 0;
      margin-bottom: 1.5rem;
      color: #f8fafc;
      font-size: 1.25rem;
    }
    .join-qr-img {
      max-width: 280px;
      width: 100%;
      height: auto;
      border-radius: 0.5rem;
      display: block;
      margin: 0 auto;
    }
    .join-modal-close {
      position: absolute;
      top: 0.5rem;
      right: 1rem;
      background: none;
      border: none;
      color: #94a3b8;
      font-size: 2rem;
      line-height: 1;
      cursor: pointer;
      transition: color 0.2s;
    }
    .join-modal-close:hover {
      color: #f8fafc;
    }
  </style>

  <script>
    const scrollHero = document.querySelector("[data-scroll-video-hero]");
    const scrollVideo = document.querySelector("[data-scroll-video]");
    const scrollPanels = Array.from(document.querySelectorAll("[data-scroll-panel]"));
    const scrollProgress = document.querySelector("[data-scroll-progress]");
    let scrollFrame = 0;

    const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

    const updateScrollHero = () => {
      scrollFrame = 0;
      if (!(scrollHero instanceof HTMLElement) || !(scrollVideo instanceof HTMLVideoElement)) return;

      const scrollRange = Math.max(1, scrollHero.offsetHeight - window.innerHeight);
      const rect = scrollHero.getBoundingClientRect();
      const progress = clamp(-rect.top / scrollRange, 0, 1);
      const duration = Number.isFinite(scrollVideo.duration) ? scrollVideo.duration : 0;

      if (duration > 0) {
        const targetTime = Math.min(duration - 0.04, Math.max(0, progress * duration));
        if (Math.abs(scrollVideo.currentTime - targetTime) > 0.035) {
          scrollVideo.currentTime = targetTime;
        }
      }

      if (scrollProgress instanceof HTMLElement) {
        scrollProgress.style.transform = `scaleX(${progress})`;
      }

      if (scrollPanels.length > 0) {
        const activeIndex = Math.min(scrollPanels.length - 1, Math.floor(progress * scrollPanels.length));
        scrollPanels.forEach((panel, index) => {
          panel.classList.toggle("active", index === activeIndex);
        });
      }
    };

    const requestScrollHeroUpdate = () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(updateScrollHero);
    };

    if (scrollVideo instanceof HTMLVideoElement) {
      scrollVideo.muted = true;
      scrollVideo.pause();
      scrollVideo.load();
      scrollVideo.addEventListener("loadedmetadata", updateScrollHero);
      const warmup = scrollVideo.play();
      if (warmup) {
        warmup
          .then(() => {
            scrollVideo.pause();
            updateScrollHero();
          })
          .catch(() => {
            updateScrollHero();
          });
      }
    }

    window.addEventListener("scroll", requestScrollHeroUpdate, { passive: true });
    window.addEventListener("resize", requestScrollHeroUpdate);
    updateScrollHero();

    const track = document.querySelector("[data-alliance-track]");
    if (track instanceof HTMLElement) {
      const count = Number(track.dataset.memberCount || 0);
      const sourceItems = Array.from(track.children).slice(0, count);
      for (let index = sourceItems.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [sourceItems[index], sourceItems[swapIndex]] = [sourceItems[swapIndex], sourceItems[index]];
      }
      const firstLoop = sourceItems.map((item) => item.cloneNode(true));
      const secondLoop = sourceItems.map((item) => item.cloneNode(true));
      track.replaceChildren(...firstLoop, ...secondLoop);
    }

    // Modal Logic
    const joinBtns = document.querySelectorAll('.join-btn');
    const modal = document.getElementById('join-modal');
    const closeBtn = document.querySelector('.join-modal-close');

    joinBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        modal?.classList.add('active');
      });
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.remove('active');
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
      }
    });
  </script>
</SiteLayout>
