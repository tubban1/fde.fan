      { href: "/learn/evaluation", label: "AI 评估", labelEn: "Evaluation" },
      { href: "/learn/consulting", label: "Soft Stack", labelEn: "Soft Stack" },
      { href: "/learn/ecommerce-ai", label: "跨境电商 AI 课程", labelEn: "Ecommerce AI" },
      { href: "/learn/deployment", label: "部署与交付", labelEn: "Deployment and Delivery" },
    ],
  },
  {
    label: "FDE 职业进阶",
    labelEn: "FDE Career Track",
    items: [
      { href: "/learn/fde-career", label: "职业进阶总览", labelEn: "Career Track" },
      { href: "/learn/fde-career/interview-prep", label: "职业能力地图", labelEn: "Capability Map" },
      { href: "/learn/fde-career/vibe-coding", label: "AI 工具协作开发", labelEn: "Vibe Coding" },
      { href: "/learn/fde-career/agentic-system-design", label: "生产级 Agent 系统设计", labelEn: "Agentic System Design" },
      { href: "/learn/fde-career/dsa-lite", label: "DSA Lite 技术表达", labelEn: "DSA Lite" },
      { href: "/learn/fde-career/mock-interview", label: "Mock Interview 与复盘", labelEn: "Mock Interview" },
    ],
  },
  {
    label: "12 篇基础教程",
    labelEn: "12 Tutorials",
    items: [
      { href: "/learn/tutorials/01-fde-role", label: "01 FDE 岗位认知", labelEn: "01 FDE Role" },
      { href: "/learn/tutorials/02-html-css-layout", label: "02 HTML/CSS 布局", labelEn: "02 HTML/CSS Layout" },
      { href: "/learn/tutorials/03-javascript-react", label: "03 JavaScript/React", labelEn: "03 JavaScript/React" },
      { href: "/learn/tutorials/04-git-vite-deploy", label: "04 Git/Vite/部署", labelEn: "04 Git/Vite/Deploy" },
      { href: "/learn/tutorials/05-requirement-breakdown", label: "05 需求拆解", labelEn: "05 Requirement Breakdown" },
