      { href: "/industries", label: "行业实验室", labelEn: "Industry Labs" },
      { href: "/industries/cross-border-commerce", label: "跨境电商", labelEn: "Cross-border Commerce" },
      { href: "/industries/culture-tourism", label: "文旅 AI", labelEn: "Culture Tourism" },
    ],
  },
  {
    label: "案例库",
    labelEn: "Case Library",
    items: [
      { href: "/cases", label: "案例总览", labelEn: "Case Overview" },
      { href: "/cases/ad-copy-batch", label: "广告文案批量生成", labelEn: "Ad Copy Batch" },
      { href: "/cases/cross-border-ai-diagnosis", label: "跨境 AI 诊断", labelEn: "Cross-border AI Diagnosis" },
      { href: "/cases/customer-review-insights", label: "客户评论洞察", labelEn: "Customer Review Insights" },
      { href: "/cases/enterprise-transformation-diagnosis-agent", label: "企业转型诊断 Agent", labelEn: "Enterprise Diagnosis Agent" },
      { href: "/cases/faq-agent", label: "FAQ Agent", labelEn: "FAQ Agent" },
      { href: "/cases/knowledge-base-qa", label: "知识库问答", labelEn: "Knowledge Base QA" },
      { href: "/cases/product-info-organizer", label: "产品信息整理", labelEn: "Product Info Organizer" },
      { href: "/cases/request-routing-system", label: "请求路由系统", labelEn: "Request Routing System" },
      { href: "/cases/tiktok-content-matrix", label: "TikTok 内容矩阵", labelEn: "TikTok Content Matrix" },
      { href: "/cases/tool-matrix-recommender", label: "工具矩阵推荐器", labelEn: "Tool Matrix Recommender" },
