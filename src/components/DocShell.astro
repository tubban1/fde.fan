      { href: "/learn/tutorials/07-agent-basics", label: "07 Agent 基础", labelEn: "07 Agent Basics" },
      { href: "/learn/tutorials/08-diagnosis-agent-breakdown", label: "08 Diagnosis Agent 拆解", labelEn: "08 Diagnosis Agent Breakdown" },
      { href: "/learn/tutorials/09-ecommerce-scenarios", label: "09 跨境电商场景", labelEn: "09 Ecommerce Scenarios" },
      { href: "/learn/tutorials/10-wechat-og-sharing", label: "10 微信分享图配置", labelEn: "10 WeChat OG Sharing" },
      { href: "/learn/tutorials/11-delivery-docs", label: "11 交付文档", labelEn: "11 Delivery Docs" },
      { href: "/learn/tutorials/12-portfolio-review", label: "12 作品集 Review", labelEn: "12 Portfolio Review" },
    ],
  },
  {
