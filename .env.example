# FDE FAN local environment example.
# Copy to .env.local for local testing, and mirror production values in Vercel.

# Database
DATA_URL=
DATA_SSL=true

# Public site URL used inside email links
PUBLIC_SITE_URL=https://www.fde.fan

# Tencent Exmail SMTP email verification / password reset
EMAIL_HOST=smtp.exmail.qq.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=FDE FAN
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=10000
EMAIL_EHLO_DOMAIN=fde.fan
EMAIL_INTERVAL=0

# One-time protected endpoint for hashing legacy plaintext auth passwords.
# POST /api/diagnosis-auth/migrate-passwords with Authorization: Bearer <token>
AUTH_MIGRATION_TOKEN=

# AI events ingestion
AI_EVENTS_WORKER_CONCURRENCY=2
AI_EVENTS_SCHEDULER_INTERVAL_MINUTES=60
AI_EVENTS_MIN_INTERVAL_MINUTES=120
AI_EVENTS_FORCE_RUN=0
AI_EVENTS_FETCH_TIMEOUT_MS=20000
AI_EVENTS_FETCH_CANDIDATE_DETAILS=1
AI_EVENTS_RAW_ONLY=0
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_NAME=
MODEL_API_FORMAT=generate_content
MODEL_TIMEOUT_MS=30000
MODEL_RETRY_COUNT=2
MODEL_RETRY_DELAY_MS=5000
AI_EVENTS_SEARCH_PROVIDER=fixture
AI_EVENTS_SEARCH_API_KEY=
REDIS_URL=
ADMIN_ACCESS_TOKEN=
