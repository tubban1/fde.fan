# FDE FAN local environment example.
# Copy to .env.local for local testing, and mirror production values in Vercel.

# Database
DB_PROVIDER=supabase
SUPABASE_DB_URL=
SUPABASE_DB_SSL=true

# Public site URL used inside email links
PUBLIC_SITE_URL=https://www.fde.fan

# Aliyun SMTP email verification / password reset
ALIYUN_SMTP_HOST=smtp.qiye.aliyun.com
ALIYUN_SMTP_PORT=465
ALIYUN_SMTP_SECURE=true
# Full mailbox address used to authenticate. Do not put the client password here.
ALIYUN_SMTP_USER=
# Optional overrides when authentication and From addresses differ.
ALIYUN_SMTP_AUTH_USER=
ALIYUN_SMTP_FROM_ADDRESS=
# Aliyun mailbox password or the generated third-party client security password.
ALIYUN_SMTP_PASSWORD=
ALIYUN_SMTP_FROM_NAME=FDE FAN
ALIYUN_SMTP_REPLY_TO=
ALIYUN_SMTP_TIMEOUT_MS=10000
ALIYUN_SMTP_EHLO_DOMAIN=fde.fan

# One-time protected endpoint for hashing legacy plaintext auth passwords.
# POST /api/diagnosis-auth/migrate-passwords with Authorization: Bearer <token>
AUTH_MIGRATION_TOKEN=
